table "main"."items" {
  primaryKey = {
    columns = [
      "id"
    ]
    name = "items_pkey"
    objectType = primaryKey
  }
  owner = postgres
  columns = (
    column "id" {
      type = integer
      null = NOT NULL
      default = nextval('main.items_id_seq'::regclass)
    }
    column "name" {
      type = character varying(100)
    }
    column "code" {
      type = character varying(50)
    }
    column "quantity" {
      type = integer
    }
    column "description" {
      type = text
    }
    column "created_at" {
      type = timestamp without time zone
      default = CURRENT_TIMESTAMP
    }
  )
}

